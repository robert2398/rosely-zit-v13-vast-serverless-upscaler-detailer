# Vast Serverless / ComfyUI
SERVERLESS=true
BACKEND=comfyui-json
PYWORKER_REPO=https://github.com/vast-ai/pyworker
# Verified upstream pyworker main commit on 2026-09-12. Pin it so worker behavior cannot drift.
PYWORKER_REF=2207a3f94b55a0921c1641520eeb83de5a0c1611
BENCHMARK_JSON_PATH=/workspace/zenith13_benchmark.json
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/robert2398/rosely_zit_vast_realistic_anime_unified/main/provision_vast_zit_unified.sh

# Model bundle already uploaded by Rosely
MODEL_S3_URI=s3://rosely-infrastructure/serverless/zimage/zenith13/zenith13-mxfp8-unified-test.tar.zst
MODEL_ARCHIVE_SHA256=70062f128985c4e187e50d914ebc4bc073b3941ece4221e4bd8c7e6f8e51308a
MODEL_ARCHIVE_SIZE=10703686769
MODEL_AWS_REGION=us-east-1
MODEL_AWS_ACCESS_KEY_ID=REPLACE_ME
MODEL_AWS_SECRET_ACCESS_KEY=REPLACE_ME
# MODEL_AWS_SESSION_TOKEN=
# MODEL_S3_ENDPOINT_URL=
MODEL_DOWNLOAD_CONCURRENCY=16
MODEL_MULTIPART_CHUNK_MB=64

# Generated-image S3 output. Keep your existing production output bucket/settings if different.
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET_NAME=REPLACE_ME
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1

# Only used if pyworker ever falls back instead of using our explicit benchmark JSON.
BENCHMARK_TEST_WIDTH=512
BENCHMARK_TEST_HEIGHT=896
BENCHMARK_TEST_STEPS=4
